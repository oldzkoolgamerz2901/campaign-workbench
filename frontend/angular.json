{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "campaign-workbench": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/app/preparation/prototype-loader.ts",
                  "with": "src/app/preparation/prototype-loader.production.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "card-layout": {
              "browser": "layout-fixture/main.ts",
              "tsConfig": "layout-fixture/tsconfig.json",
              "optimization": false,
              "sourceMap": true,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "layouts.json",
                  "input": ".angular/card-layout-fixture",
                  "output": "fixtures"
                }
              ]
            },
            "player": {
              "browser": "player/main.ts",
              "index": "player/index.html",
              "tsConfig": "player/tsconfig.json",
              "baseHref": "/player/",
              "outputPath": "dist/player",
              "optimization": true,
              "sourceMap": false,
              "outputHashing": "all",
              "assets": [],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "campaign-workbench:build:production"
            },
            "development": {
              "buildTarget": "campaign-workbench:build:development"
            },
            "card-layout": {
              "buildTarget": "campaign-workbench:build:card-layout"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "host": "127.0.0.1",
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
